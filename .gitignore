# dependencies / builds
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# secrets and local environment - never commit values
.env
.env.*
!.env.example
# .env.* above already covers .env.production.local; named here so it is
# obvious the production profile is a local file and never committed.

# local test email capture inbox (contains reusable magic URLs)
.email-capture/

# playwright artifacts
test-results/
playwright-report/
blob-report/
playwright/.cache/

# OS noise
.DS_Store

# daily edition cards saved by `pnpm edition`; regenerate any time
ours-today-day-*.png

# ours-fork output; regenerate with `pnpm fork export`
/fork-export/

# Material that cannot be public without harming a person or breaking a legal
# obligation: review case notes, support correspondence, unexecuted legal
# drafts, vendor contracts. NOT a place for anything merely unflattering.
# The rule is docs/INTERNAL-BOUNDARY.md, and it is public.
/docs-internal/
