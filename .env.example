# OURS TODAY environment configuration.
# This file documents NAMES AND MEANINGS ONLY. It must never contain real values.
# Copy to .env.local for local development and fill values from your local secrets.

# Pooled runtime connection used by the application.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=prefer
# Direct (owner) connection used ONLY by migrations and controlled dumps.
DIRECT_DATABASE_URL=postgresql://OWNER:PASSWORD@HOST:5432/DATABASE

# Better Auth secret(s) for signing sessions/tokens. Rotate per SECRET-ROTATION.md.
BETTER_AUTH_SECRET=
# Public base URL Better Auth is mounted at, per environment.
BETTER_AUTH_URL=http://127.0.0.1:3000
# Browser-visible base URL (the only intentionally public variable).
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Transactional email. RESEND_API_KEY stays empty in capture mode.
RESEND_API_KEY=
RESEND_FROM="OURS TODAY <enter@updates.ourstoday.com>"
# capture = write emails to a local test-only inbox adapter (.email-capture/, gitignored).
# resend  = deliver through Resend (requires authorized sending domain).
EMAIL_DELIVERY_MODE=capture

# Versioned HMAC keys for relay URL signing. Current key first:
#   "1:<secret>" or comma-separated "2:<new-secret>,1:<old-secret>" for rotation.
RELAY_SIGNING_SECRET=

# Master canonical-write gate. The database gate (ledger.system_state.mode)
# must ALSO be OPEN. Both default to closed/false.
ALLOW_CANONICAL_WRITES=false
APP_ENV=local
